# Govee Multi-House Light Sync - Environment Configuration
# Copy this file to .env if you want to customize settings or add a Govee Cloud API key.

# Web UI & FastAPI server port (runs with network_mode: host)
PORT=8200
HOST=0.0.0.0
PUBLIC_BASE_URL=https://govee-sync.example.com
OWNER_EMAIL=owner@example.com
OWNER_GITHUB_USER=
AUTH_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GSI_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BRIDGE_BASE=

# Persistent data folder on the host
DATA_DIR=/mnt/media/govee_lights_sync/data

# Optional: Govee Developer Cloud API Key (for Cloud API discovery & segmentedColorRgb fallback)
# Request one in the Govee Home App -> Profile -> Settings -> Apply for API Key
GOVEE_API_KEY=

# Govee LAN UDP Ports & Multicast Group
GOVEE_LAN_MULTICAST=239.255.255.250
GOVEE_LAN_SCAN_PORT=4001
GOVEE_LAN_LISTEN_PORT=4002
GOVEE_LAN_CONTROL_PORT=4003

# Animation Engine target frame rate (10 - 60 FPS)
GOVEE_DEFAULT_FPS=25

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
